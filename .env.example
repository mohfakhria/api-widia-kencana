APP_ENV=local
APP_PORT=8080
# debug|info|warn|error. debug menyalakan jejak pesan WebSocket per klien.
LOG_LEVEL=info
APP_BASEURL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=widia_kencana

# Kosongkan COOKIE_DOMAIN agar cookie host-only (disarankan).
# COOKIE_SECURE default mengikuti skema APP_BASEURL; isi hanya bila TLS diterminasi di proxy.
COOKIE_DOMAIN=
# COOKIE_SECURE=true

JWT_SECRET=change-this-in-env
JWT_SUB_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

MINIO_ENDPOINT=localhost:9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=widia-assets
MINIO_USE_SSL=false

# Direktori berkas font untuk export PDF, beserta manifes fonts.json di dalamnya.
# Berkas yang sama wajib disajikan ke frontend agar hasil cetak sama dengan layar.
DESIGN_FONT_DIR=assets/fonts
