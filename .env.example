APP_ENV=local
APP_PORT=8080
# debug|info|warn|error. debug menyalakan jejak pesan WebSocket per klien.
LOG_LEVEL=info

# Asal yang boleh bicara dengan API ini. Menjaga CORS sekaligus handshake
# WebSocket. Yang dicocokkan host beserta portnya — skema boleh ditulis dan
# diabaikan, karena yang menentukan http/https adalah reverse proxy.
#
# Beberapa asal dipisah koma; spasi setelah koma boleh. Pola glob berlaku, dan
# * mencakup titik — *.example.com juga menerima a.b.example.com. Contoh:
#
#   ALLOWED_ORIGINS=app.example.com,admin.example.com,dev.local:5173
#   ALLOWED_ORIGINS="app.example.com,*.example.com"
#
# Kutip nilainya bila mengandung * DAN berkas ini pernah di-source lewat shell;
# godotenv dan systemd membacanya tanpa shell, jadi keduanya tidak terpengaruh.
#
# KOSONG BERARTI TIDAK ADA yang diizinkan. Saat APP_ENV=local, seluruh host
# loopback sudah diizinkan tanpa perlu diisi.
ALLOWED_ORIGINS=

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=widia_kencana

# Kosongkan COOKIE_DOMAIN agar cookie host-only (disarankan).
# COOKIE_SECURE wajib true saat APP_ENV=production. Bawaannya false.
COOKIE_DOMAIN=
# COOKIE_SECURE=true

JWT_SECRET=change-this-in-env
JWT_SUB_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# MINIO_ENDPOINT adalah host yang MENANDATANGANI presigned URL, dan MinIO
# memvalidasinya terhadap header Host yang ia terima. Karena browser mengunggah
# LANGSUNG ke sana, nilainya harus nama yang dapat dijangkau browser — bukan
# alamat internal.
#
# Di belakang nginx, ketiganya harus menyebut nama yang sama:
#
#   MINIO_ENDPOINT=api-storage.widiakencana.com   (tanpa skema, tanpa port)
#   MINIO_USE_SSL=true                            (setelah certbot)
#   proxy_set_header Host $host;                  (di vhost-nya)
#
# Melenceng satu saja menghasilkan SignatureDoesNotMatch — galat yang tidak
# menyebut host sama sekali, sehingga paling sering disalahartikan sebagai
# kredensial yang keliru.
MINIO_ENDPOINT=localhost:9002
# Kredensial ROOT. Untuk produksi, ganti dengan user MinIO terbatas yang hanya
# boleh membaca dan menulis pada bucket ini — root memberi kuasa menghapus
# seluruh bucket kepada siapa pun yang memegang berkas env ini.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=widia-assets
MINIO_USE_SSL=false
