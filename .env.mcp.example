# Konfigurasi MCP server.
#
# BERKAS TERSENDIRI, bukan .env milik API — dan itu disengaja. .env API memuat
# sandi database, kredensial MinIO, dan JWT_SECRET; MCP tidak membutuhkan satu
# pun di antaranya. MCP adalah KLIEN API: yang ia tahu hanya alamat API dan cara
# masuk sebagai agent.
#
#   cp .env.mcp.example .env.mcp
#   go run ./cmd/mcp
#
# Di server, env datang dari unit systemd dan berkas ini tidak dipakai.

MCP_PORT=9090

# Satu alamat untuk HTTP DAN WebSocket, karena keduanya dilayani proses serta
# port yang sama. Dua variabel yang wajib menunjuk server yang sama adalah dua
# kesempatan untuk meleset.
#
# Loopback bila MCP dan API satu mesin: tanpa TLS, tanpa lompatan nginx, tanpa
# bergantung pada DNS maupun sertifikat.
API_BASE_URL=http://127.0.0.1:8080

# Akun agent di tabel users, peran 'ai-agent'.
#
# SANDI, bukan token, dan itu keputusan sadar. Penyimpanan sesi API ada di
# memori proses, sehingga setiap restart — termasuk setiap deploy — menghapus
# seluruh sesi. Klien yang hanya memegang token akan mati bersamanya; yang
# memegang sandi berdiri lagi sendiri tanpa ditunggui.
AGENT_EMAIL=ai-agent@widiakencana.com
AGENT_PASSWORD=

# Penjaga MCP itu sendiri. WAJIB diisi; server menolak berdiri tanpanya.
#
# Server ini memegang sandi agent, sehingga siapa pun yang menjangkaunya ADALAH
# agent — dan agent boleh menghapus dokumen serta aset. Begitu
# mcp.widiakencana.com terbit, tanpa token ini wewenang tersebut menjadi publik.
#
# Sejak OAuth ada, ini BUKAN lagi satu-satunya jalur masuk — ia rahasia bersama
# yang melewati seluruh alur persetujuan, tidak dapat dicabut per klien, dan
# tidak menyebutkan siapa pemakainya di catatan. Berguna untuk pemeriksaan dari
# baris perintah. Setelah semua klien berpindah ke OAuth, ia layak dibuang.
#
# Bangkitkan yang acak dan panjang, misalnya:
#   openssl rand -base64 32
MCP_AUTH_TOKEN=

# Alamat MCP sebagaimana DILIHAT DUNIA LUAR — issuer OAuth.
#
# Seluruh alamat OAuth lain diturunkan dari sini, dan klien MEMBANDINGKAN issuer
# pada metadata dengan alamat yang ia minta. Selisih sekecil skema atau garis
# miring di ujung membatalkan penyambungan dengan pesan yang tidak menyebut
# sebabnya.
#
# TIDAK diturunkan dari header Host: nilai itu datang dari pemanggil dan dapat
# dipalsukan, sehingga penyerang dapat membuat kita mengumumkan authorization
# server miliknya sendiri.
#
# Bawaannya http://127.0.0.1:<MCP_PORT> supaya percobaan setempat tidak menuntut
# konfigurasi. Di produksi WAJIB diisi, dan HARUS https — konektor menolak
# authorization server tanpa TLS.
MCP_PUBLIC_URL=https://mcp.widiakencana.com
