[Unit]
Description=API Widia Kencana
After=network-online.target
Wants=network-online.target
# Postgres dan MinIO yang satu mesin disebut di sini; yang di mesin lain tidak
# perlu, karena aplikasi ini toh sudah harus tahan terhadap keduanya belum siap.
# After= bukan jaminan layanannya sudah menerima koneksi, hanya sudah dimulai.
# After=postgresql.service minio.service

[Service]
Type=exec

# Berjalan sebagai root, dan itu pilihan sadar demi kesederhanaan pemasangan —
# tidak ada user layanan yang perlu dibuat dan tidak ada kepemilikan berkas yang
# perlu diatur.
#
# Yang membuatnya masih dapat diterima adalah CapabilityBoundingSet dan
# AmbientCapabilities yang KOSONG di bawah: proses ini ber-UID 0 tetapi tidak
# memegang satu pun capability, sehingga ia tidak dapat mengikat port di bawah
# 1024, memuat modul kernel, mengubah kepemilikan berkas milik orang lain, maupun
# menembus izin berkas lewat CAP_DAC_OVERRIDE. Digabung dengan ProtectSystem=strict
# yang membuat seluruh sistem berkas hanya-baca, yang tersisa dari "root" tinggal
# namanya untuk sebagian besar hal yang berbahaya.
#
# Karena itu JANGAN mengisi kedua baris capability itu tanpa alasan yang jelas.
# Menjalankan sebagai root DAN memegang capability penuh adalah gabungan yang
# menghapus hampir seluruh pengerasan di berkas ini sekaligus.
User=root
Group=root

WorkingDirectory=/opt/widia-api
ExecStart=/opt/widia-api/widia-api

# Konfigurasi masuk sebagai environment sungguhan, bukan lewat berkas .env di
# direktori kerja. Aplikasi tetap memanggil godotenv saat start dan akan menulis
# satu baris "warning: .env file not found, using system env" ke log — itu wajar
# di server dan bukan tanda ada yang salah.
#
# Berkas ini memuat JWT_SECRET, kredensial MinIO, dan kata sandi database.
# Milik root, mode 0600.
#
# TIDAK dipakai widia-mcp. MCP punya berkasnya sendiri di /etc/widia-mcp/mcp.env,
# karena ia tidak membutuhkan satu pun rahasia di atas — lihat unit itu.
EnvironmentFile=/etc/widia-api/api.env

Restart=on-failure
RestartSec=5s

# main.go memasang signal.NotifyContext untuk SIGINT dan SIGTERM, jadi SIGTERM
# bawaan systemd sudah memicu shutdown bersih.
#
# TimeoutStopSec HARUS di atas jalur berhenti terpanjang, yaitu roomStopTimeout
# 8 detik pada usecase/documentdesign — batas menunggu seluruh orchestrator
# dokumen menyimpan suntingan terakhirnya. Server HTTP berhenti paralel dengan
# batasnya sendiri 5 detik. Angka di bawah 8 detik membuat systemd membunuh
# proses tepat di tengah penyimpanan itu, dan yang hilang adalah suntingan
# terakhir pengguna. Bila roomStopTimeout dinaikkan, naikkan juga yang ini.
KillSignal=SIGTERM
TimeoutStopSec=30s

# --- Pengerasan -------------------------------------------------------------
# Aplikasi ini tidak menulis apa pun ke disk: unggahan mendarat di MinIO, data
# di Postgres, log ke journald. Karena itu seluruh sistem berkas boleh dikunci
# hanya-baca tanpa perlu satu pengecualian pun.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Kosong berarti proses ini TIDAK BISA mengikat port di bawah 1024. Disengaja:
# APP_PORT semestinya 8080 di belakang reverse proxy. Bila suatu saat perlu
# mengikat :80 langsung, tambahkan CAP_NET_BIND_SERVICE di kedua baris — jangan
# menjalankannya sebagai root.
CapabilityBoundingSet=
AmbientCapabilities=

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
