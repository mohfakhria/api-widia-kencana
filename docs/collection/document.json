  "item": [
    {
      "name": "List Documents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/document-list?name=&document_type=&status=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "document-list"
          ],
          "query": [
            {
              "key": "name",
              "value": ""
            },
            {
              "key": "document_type",
              "value": ""
            },
            {
              "key": "status",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "Get Document Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/document-detail/{{document_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "document-detail",
            "{{document_token}}"
          ]
        },
        "description": "Replace document_token with the document token returned by create/list."
      }
    },
    {
      "name": "Create Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_paper_token\": \"{{document_paper_token}}\",\n  \"parent_token\": \"\",\n  \"name\": \"Quotation Default\",\n  \"document_type\": \"quotation\",\n  \"settings\": {},\n  \"position\": 1,\n  \"status\": \"draft\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/document-add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "document-add"
          ]
        }
      }
    },
    {
      "name": "Update Document",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_paper_token\": \"{{document_paper_token}}\",\n  \"parent_token\": \"\",\n  \"name\": \"Quotation Default v2\",\n  \"document_type\": \"quotation\",\n  \"settings\": {},\n  \"position\": 2,\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/document-update/{{document_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "document-update",
            "{{document_token}}"
          ]
