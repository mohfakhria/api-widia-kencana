{
  "info": {
    "_postman_id": "fe503373-8a91-4c01-a884-0deff835f5eb",
    "name": "Widia Kencana - Asset",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Asset management endpoints with presigned upload and download URLs."
  },
  "item": [
    {
      "name": "Request Asset Upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"original_filename\": \"logo.png\",\n  \"mime_type\": \"image/png\",\n  \"size\": 48291,\n  \"scope\": \"documents\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/asset-upload-request",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-upload-request"
          ]
        },
        "description": "Creates a pending asset record and returns a temporary PUT URL for direct upload to object storage."
      }
    },
    {
      "name": "Complete Asset Upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/asset-upload-complete/{{asset_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-upload-complete",
            "{{asset_token}}"
          ]
        },
        "description": "Call after the frontend uploads the file to the presigned PUT URL. Backend validates the object in storage and marks the asset uploaded."
      }
    },
    {
      "name": "List Assets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/asset-list?status=uploaded&scope=documents&mime_type=&extension=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-list"
          ],
          "query": [
            {
              "key": "status",
              "value": "uploaded"
            },
            {
              "key": "scope",
              "value": "documents"
            },
            {
              "key": "mime_type",
              "value": ""
            },
            {
              "key": "extension",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "Get Asset Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/asset-detail/{{asset_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-detail",
            "{{asset_token}}"
          ]
        }
      }
    },
    {
      "name": "Presign Asset Download",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/asset-presign/{{asset_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-presign",
            "{{asset_token}}"
          ]
        },
        "description": "Returns a temporary GET URL for preview or download. Requires login.\n\nFor displaying an image, prefer asset-content: it needs no prior call and its URL never expires."
      }
    },
    {
      "name": "Get Asset Content",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/asset-content/{{asset_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-content",
            "{{asset_token}}"
          ]
        },
        "description": "Redirects (302) to the object in storage, with a signature rebuilt on every request. Meant to be used directly as an image source:\n\n    <img src=\"/api/asset-content/{assetToken}\">\n\nThe URL is stable and never expires — only the redirect target does, and that is regenerated each time. No presign call is needed beforehand and nothing has to be refreshed.\n\nNO Authorization header: an <img> tag cannot send one, so the asset token itself is the credential. Anyone holding the UUID can read the image. Use asset-presign instead when you need the signed URL itself, for example to download it.\n\nResponds 400 when the asset is not uploaded yet, and 404 when it no longer exists."
      }
    },
    {
      "name": "Delete Asset",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/asset-delete/{{asset_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "asset-delete",
            "{{asset_token}}"
          ]
        },
        "description": "Deletes the object from storage when uploaded, then soft-deletes the asset metadata."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "asset_token",
      "value": ""
    }
  ]
}
