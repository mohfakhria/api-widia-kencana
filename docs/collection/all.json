                {
                    "name": "Request Asset Upload",
                    "request": {
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"original_filename\": \"logo.png\",\n  \"mime_type\": \"image/png\",\n  \"size\": 48291,\n  \"scope\": \"documents\"\n}"
                        },
                        "description": "Creates a pending asset record and returns a temporary PUT URL for direct upload to object storage.",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
